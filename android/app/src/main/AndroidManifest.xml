<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- open_app: list installed apps to find one by spoken name -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- floating mic button over every app → works in the background -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- auto-update: download the newest APK from GitHub and install it -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:label="Gadacz"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Gadacz"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FileProvider so the downloaded APK can be handed to the installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="pl.gadacz.app.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Floating mic button + always-on brain: keeps Gadacz reachable from
             inside ANY app, even when its own screen is closed. -->
        <service
            android:name=".GadaczOverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- The one door Android opens for screen control — the user enables it
             manually in Settings → Accessibility → Gadacz -->
        <service
            android:name=".GadaczAccessibilityService"
            android:exported="false"
            android:label="Gadacz — sterowanie głosem"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>

# Run buduje paczkę ZE ŚWIEŻYCH plików przy każdym starcie — koniec z serwowaniem
# starego dist (paczka z 21 czerwca udawała „cofnięty" projekt). Naprawa 10.07.
run = "bash -c 'npm run build && node dist/index.cjs'"
entrypoint = "server/index.ts"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

[deployment]
run = ["node", "dist/index.cjs"]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'npm run build && node dist/index.cjs'"
waitForPort = 3000
